{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitrustalliance.com/schema/trp/0.5/trp.schema.json",
  "title": "Trust Requirements Profile (TRP) v0.5 draft",
  "description": "Draft JSON Schema for a Trust Requirements Profile. Defines the shape of a profile: how signals, rules, drift, bands, and standing are expressed. It is an open-ended grammar, not a fixed list of signals; a profile may declare any number of signals. It does not define how a standing is computed. Version 0.5 draft, expected to evolve.",
  "type": "object",
  "required": [
    "trp_id",
    "spec_version",
    "version",
    "authority",
    "scope",
    "standing_bands"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    },
    "trp_id": {
      "type": "string",
      "description": "Stable identifier for this profile, unique within its authoring authority.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "spec_version": {
      "type": "string",
      "description": "The TRP spec version this profile targets, for example 0.5.",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "The profile's own version, MAJOR.MINOR.PATCH.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the profile.",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "authority": {
      "type": "string",
      "description": "Identifier of the party responsible for the profile."
    },
    "author": {
      "type": "object",
      "description": "The domain expert who wrote and maintains the profile.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp of creation."
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339. The profile is not in force before this time."
    },
    "valid_to": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339. The profile is not in force after this time. If both are present, valid_to must be at or after valid_from."
    },
    "license": {
      "type": "string",
      "description": "License identifier for the profile, for example an SPDX identifier."
    },
    "taxonomy": {
      "type": "object",
      "description": "Classification of the profile's domain and use case.",
      "properties": {
        "industry": {
          "type": "string"
        },
        "use_case": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    },
    "scope": {
      "type": "object",
      "description": "What the profile covers and excludes.",
      "required": [
        "intended_use"
      ],
      "properties": {
        "intended_use": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    },
    "scored_signals": {
      "type": "array",
      "description": "Measured indicators that contribute to standing. The schema defines the shape of a signal, not which signals must exist.",
      "items": {
        "type": "object",
        "required": [
          "signal",
          "weight",
          "direction",
          "warning_threshold",
          "critical_threshold"
        ],
        "properties": {
          "signal": {
            "type": "string",
            "description": "Signal name, unique within the array."
          },
          "weight": {
            "type": "number",
            "description": "Relative contribution to standing. Weight 0 means monitored but not scored.",
            "minimum": 0
          },
          "direction": {
            "type": "string",
            "description": "Which direction is unsafe.",
            "enum": [
              "higher_is_unsafe",
              "lower_is_unsafe"
            ]
          },
          "warning_threshold": {
            "type": "number"
          },
          "critical_threshold": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "on_missing": {
            "type": "string",
            "description": "How a missing value for this signal is treated. Default incomplete.",
            "enum": [
              "critical",
              "incomplete",
              "ignore"
            ]
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {},
          "^https://\\S+$": {},
          "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
        }
      }
    },
    "hard_rules": {
      "type": "array",
      "description": "Conditions that are decisive on their own. A met rule applies its action regardless of scored standing.",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "field",
          "condition",
          "action"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "field": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "description": "The comparison applied to the field.",
            "enum": [
              "is_true",
              "is_false",
              "equals",
              "not_equals",
              "less_than",
              "greater_than"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ],
            "description": "The operand. Omitted for is_true and is_false."
          },
          "action": {
            "type": "string",
            "description": "The action an enforcement layer applies when the rule is met.",
            "enum": [
              "halt",
              "block_startup",
              "require_review"
            ]
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {},
          "^https://\\S+$": {},
          "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
        }
      }
    },
    "drift": {
      "type": "object",
      "description": "A sustained trend toward an unsafe state across successive assessments, independent of the thresholds.",
      "required": [
        "window",
        "signals"
      ],
      "properties": {
        "window": {
          "type": "integer",
          "description": "Number of consecutive samples over which a trend is assessed. Greater than 1.",
          "minimum": 2
        },
        "signals": {
          "type": "array",
          "description": "Signals monitored for drift. Each must also appear in scored_signals.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    },
    "standing_bands": {
      "type": "array",
      "description": "The named outcome levels a profile declares. Describes how standing is expressed, not how it is computed.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "band",
          "severity"
        ],
        "properties": {
          "band": {
            "type": "string"
          },
          "severity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Ordinal rank from 0 to 10, lower is better."
          },
          "range": {
            "type": "string",
            "description": "Plain description of when this band applies."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {},
          "^https://\\S+$": {},
          "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
        }
      }
    },
    "required_standing": {
      "type": "object",
      "description": "The minimum standing a profile requires of a subject, and the response at each band.",
      "required": [
        "minimum_acceptable_band"
      ],
      "properties": {
        "minimum_acceptable_band": {
          "type": "string",
          "description": "The lowest acceptable band. Must be a declared band."
        },
        "source_requirement": {
          "type": "string",
          "description": "Any requirement the profile places on the evaluation source, for example that it be independent or accredited."
        },
        "response_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "band",
              "response"
            ],
            "properties": {
              "band": {
                "type": "string"
              },
              "response": {
                "type": "string",
                "enum": [
                  "full",
                  "restricted",
                  "suspended",
                  "revoked"
                ]
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {},
              "^https://\\S+$": {},
              "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
            }
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    },
    "assurance_mapping": {
      "type": "array",
      "description": "Informative mappings of the profile's requirements to external frameworks. Does not change normative requirements.",
      "items": {
        "type": "object",
        "required": [
          "framework"
        ],
        "properties": {
          "framework": {
            "type": "string",
            "description": "The external framework, for example NIST AI RMF or ISO/IEC 42001."
          },
          "reference": {
            "type": "string",
            "description": "A reference token within that framework."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {},
          "^https://\\S+$": {},
          "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "type": "object",
      "description": "Inheritance from a base profile. The child inherits all base fields; scalars override; scored_signals and hard_rules merge by identifier; a child must not remove a base signal or rule; resolves to a single base from the root down. Cross-file merge rules are enforced by the evaluation source, not the schema.",
      "required": [
        "trp_id",
        "version"
      ],
      "properties": {
        "trp_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {},
        "^https://\\S+$": {},
        "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
      }
    }
  },
  "patternProperties": {
    "^x_": {},
    "^https://\\S+$": {},
    "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:\\S+$": {}
  }
}
