{
  "pack_version": "1",
  "id": "healthcare",
  "title": "Healthcare",
  "subtitle": "Patient data moving from hospital records into an AI model.",
  "scene": "data-flow",
  "profile": "../../../examples/healthcare-data-governance/trp.json",
  "tick_ms": 250,
  "cycle_s": 3,
  "stages": [
    "Hospital records",
    "De-identification",
    "Model training",
    "Clinical use"
  ],
  "signals": {
    "data_deidentification_confidence": {
      "base": 0.97,
      "jitter": 0.003,
      "min": 0,
      "max": 1,
      "decimals": 3,
      "label": "De-identification confidence"
    },
    "consent_coverage_ratio": {
      "base": 0.985,
      "jitter": 0.002,
      "min": 0,
      "max": 1,
      "decimals": 3,
      "label": "Consent coverage"
    },
    "model_subgroup_performance_gap": {
      "base": 0.03,
      "jitter": 0.003,
      "min": 0,
      "max": 0.4,
      "decimals": 3,
      "label": "Subgroup performance gap"
    },
    "data_freshness_hours": {
      "base": 12,
      "jitter": 0.4,
      "min": 0,
      "max": 400,
      "decimals": 0,
      "label": "Data age"
    },
    "access_log_completeness": {
      "base": 0.995,
      "jitter": 0.001,
      "min": 0,
      "max": 1,
      "decimals": 3,
      "label": "Access log completeness"
    },
    "model_confidence": {
      "base": 0.93,
      "jitter": 0.008,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Model confidence"
    },
    "hipaa_basis_verified": {
      "base": true,
      "label": "HIPAA basis"
    },
    "irb_status": {
      "base": "approved",
      "label": "Ethics board approval"
    },
    "external_sharing_without_dua": {
      "base": false,
      "label": "External sharing"
    },
    "phi_training_review_status": {
      "base": "reviewed",
      "label": "Training data review"
    }
  },
  "rule_labels": {
    "no_valid_hipaa_basis": "No verified legal basis under HIPAA",
    "irb_approval_expired": "Ethics board (IRB) approval expired",
    "dua_missing_for_external_share": "Shared without a data use agreement",
    "phi_in_training_data_unreviewed": "Unreviewed patient data in training"
  },
  "controls": [
    {
      "id": "deid",
      "label": "De-identification confidence",
      "type": "slider",
      "signal": "data_deidentification_confidence",
      "min": 0.7,
      "max": 1,
      "step": 0.005
    },
    {
      "id": "consent",
      "label": "Consent gaps",
      "type": "toggle",
      "effects": {
        "consent_coverage_ratio": {
          "to": 0.9,
          "ramp_s": 3
        }
      }
    },
    {
      "id": "bias",
      "label": "Model underperforms for a group",
      "type": "toggle",
      "effects": {
        "model_subgroup_performance_gap": {
          "to": 0.17,
          "ramp_s": 5
        }
      }
    },
    {
      "id": "share",
      "label": "Shared without an agreement",
      "type": "toggle",
      "effects": {
        "external_sharing_without_dua": {
          "set": true
        }
      }
    },
    {
      "id": "irb",
      "label": "Ethics approval expires",
      "type": "toggle",
      "effects": {
        "irb_status": {
          "set": "expired"
        }
      }
    },
    {
      "id": "logs",
      "label": "Access logs go missing",
      "type": "toggle",
      "effects": {
        "access_log_completeness": {
          "omit": true
        }
      }
    }
  ],
  "story": [
    {
      "at_s": 0,
      "caption": "De-identified patient records flow into model training, all within the profile."
    },
    {
      "at_s": 4,
      "caption": "Consent records fall behind for part of the data.",
      "toggle": {
        "consent": true
      }
    },
    {
      "at_s": 10,
      "caption": "The model starts underperforming for one patient group.",
      "toggle": {
        "bias": true
      }
    },
    {
      "at_s": 17,
      "caption": "Both are corrected.",
      "toggle": {
        "consent": false,
        "bias": false
      }
    },
    {
      "at_s": 22,
      "caption": "Someone shares data with a partner without a data use agreement. The flow stops.",
      "toggle": {
        "share": true
      }
    },
    {
      "at_s": 28,
      "caption": "Sharing is revoked and the flow resumes.",
      "toggle": {
        "share": false
      }
    },
    {
      "at_s": 32,
      "end": true
    }
  ],
  "arena": {
    "event": "Healthcare",
    "rounds": 8,
    "round_s": 6,
    "budget": 7,
    "harm": [
      {
        "id": "reidentification",
        "label": "Patients could be re-identified",
        "all": [
          {
            "signal": "data_deidentification_confidence",
            "op": "lt",
            "value": 0.84
          }
        ]
      },
      {
        "id": "consent_breach",
        "label": "Records used without consent",
        "all": [
          {
            "signal": "consent_coverage_ratio",
            "op": "lt",
            "value": 0.88
          }
        ]
      },
      {
        "id": "unlawful_share",
        "label": "Data shared without an agreement",
        "all": [
          {
            "signal": "external_sharing_without_dua",
            "op": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "biased_care",
        "label": "Model failing one patient group",
        "all": [
          {
            "signal": "model_subgroup_performance_gap",
            "op": "gt",
            "value": 0.12
          }
        ]
      },
      {
        "id": "irb_lapsed",
        "label": "Research running without ethics approval",
        "all": [
          {
            "signal": "irb_status",
            "op": "eq",
            "value": "expired"
          }
        ]
      }
    ],
    "moves": [
      {
        "id": "deid",
        "label": "De-identification quietly slips",
        "weight": 1.5,
        "effects": {
          "data_deidentification_confidence": {
            "to": 0.82,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "consent",
        "label": "Consent records fall behind",
        "weight": 1.5,
        "effects": {
          "consent_coverage_ratio": {
            "to": 0.86,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "bias",
        "label": "The model drifts for one group",
        "effects": {
          "model_subgroup_performance_gap": {
            "to": 0.14,
            "ramp_s": 3
          }
        }
      },
      {
        "id": "share",
        "label": "Data goes to a partner without an agreement",
        "effects": {
          "external_sharing_without_dua": {
            "set": true
          }
        }
      },
      {
        "id": "logs",
        "label": "The access log goes down",
        "weight": 1.3,
        "effects": {
          "access_log_completeness": {
            "omit": true,
            "fault": true
          }
        }
      },
      {
        "id": "irb",
        "label": "Ethics approval expires",
        "effects": {
          "irb_status": {
            "set": "expired"
          }
        }
      }
    ],
    "guards": [
      {
        "id": "deid-floor",
        "label": "Stricter de-identification floor",
        "detail": "De-identification confidence turns critical below 0.85.",
        "cost": 3,
        "type": "tighten",
        "signal": "data_deidentification_confidence",
        "warning": 0.94,
        "critical": 0.85,
        "counters": [
          "deid"
        ]
      },
      {
        "id": "consent-floor",
        "label": "Stricter consent floor",
        "detail": "Consent coverage turns critical below 0.90.",
        "cost": 3,
        "type": "tighten",
        "signal": "consent_coverage_ratio",
        "warning": 0.97,
        "critical": 0.9,
        "counters": [
          "consent"
        ]
      },
      {
        "id": "audit-log",
        "label": "Redundant audit log",
        "detail": "A second log keeps evidence flowing, so an outage causes no false stop.",
        "cost": 2,
        "type": "shield",
        "signals": [
          "access_log_completeness"
        ],
        "counters": [
          "logs"
        ]
      },
      {
        "id": "fairness-watch",
        "label": "Tighter fairness check",
        "detail": "A subgroup gap turns critical at 0.12.",
        "cost": 2,
        "type": "tighten",
        "signal": "model_subgroup_performance_gap",
        "warning": 0.06,
        "critical": 0.12,
        "counters": [
          "bias"
        ]
      }
    ]
  }
}
