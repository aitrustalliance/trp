{
  "pack_version": "1",
  "id": "agno",
  "title": "Agno",
  "subtitle": "The agnostic agent. Any model, any framework, the same trust requirements.",
  "scene": "agent-trace",
  "profile": "../../../examples/agent-tool-use/trp.json",
  "command": {
    "group": "Agents",
    "unit": "Agent",
    "count": 16,
    "fault_rate": 0.025,
    "benign": [
      {
        "label": "A long research task, 24 steps",
        "effects": {
          "steps_per_task": {
            "to": 24,
            "ramp_s": 3
          }
        }
      },
      {
        "label": "An expensive model call, 90 cents",
        "effects": {
          "cost_per_task_usd": {
            "to": 0.9,
            "ramp_s": 2
          }
        }
      }
    ],
    "benign_rate": 0.02
  },
  "tick_ms": 250,
  "cycle_s": 5,
  "tools": [
    "search",
    "read_file",
    "run_code",
    "send_email",
    "write_db"
  ],
  "signals": {
    "steps_per_task": {
      "base": 9,
      "jitter": 0.4,
      "min": 0,
      "max": 80,
      "decimals": 0,
      "label": "Steps this task"
    },
    "tool_error_rate": {
      "base": 0.01,
      "jitter": 0.003,
      "min": 0,
      "max": 1,
      "decimals": 3,
      "label": "Tool error rate"
    },
    "records_beyond_need": {
      "base": 0.02,
      "jitter": 0.004,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Data beyond need"
    },
    "grounding_score": {
      "base": 0.93,
      "jitter": 0.006,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Grounding"
    },
    "cost_per_task_usd": {
      "base": 0.12,
      "jitter": 0.01,
      "min": 0,
      "max": 10,
      "decimals": 2,
      "label": "Cost this task"
    },
    "unapproved_tool_called": {
      "base": false,
      "label": "Unapproved tool"
    },
    "secret_in_output": {
      "base": false,
      "label": "Secret in output"
    },
    "output_destination_approved": {
      "base": true,
      "label": "Output destination"
    },
    "write_without_approval": {
      "base": false,
      "label": "Write without approval"
    }
  },
  "rule_labels": {
    "unapproved_tool_called": "Unapproved tool called",
    "secret_in_output": "Access key in output",
    "unapproved_destination": "Output sent to an unapproved destination",
    "write_without_approval": "Write without approval"
  },
  "controls": [
    {
      "id": "loop",
      "label": "Agent loops",
      "type": "toggle",
      "effects": {
        "steps_per_task": {
          "to": 46,
          "ramp_s": 8
        },
        "cost_per_task_usd": {
          "to": 2.4,
          "ramp_s": 8
        }
      }
    },
    {
      "id": "overreach",
      "label": "Pulls extra records",
      "type": "toggle",
      "effects": {
        "records_beyond_need": {
          "to": 0.36,
          "ramp_s": 3
        }
      }
    },
    {
      "id": "ungrounded",
      "label": "Answers without sources",
      "type": "toggle",
      "effects": {
        "grounding_score": {
          "to": 0.74,
          "ramp_s": 3
        }
      }
    },
    {
      "id": "tool",
      "label": "Calls an unapproved tool",
      "type": "toggle",
      "effects": {
        "unapproved_tool_called": {
          "set": true
        }
      }
    },
    {
      "id": "secret",
      "label": "Leaks a key in output",
      "type": "toggle",
      "effects": {
        "secret_in_output": {
          "set": true
        }
      }
    },
    {
      "id": "write",
      "label": "Writes without approval",
      "type": "toggle",
      "effects": {
        "write_without_approval": {
          "set": true
        }
      }
    }
  ],
  "story": [
    {
      "at_s": 0,
      "caption": "Agno works a task, step by step, using only approved tools."
    },
    {
      "at_s": 4,
      "caption": "It starts pulling more customer records than the task needs.",
      "toggle": {
        "overreach": true
      }
    },
    {
      "at_s": 10,
      "caption": "Scope is pulled back.",
      "toggle": {
        "overreach": false
      }
    },
    {
      "at_s": 13,
      "caption": "It gets stuck in a loop. Steps and cost climb.",
      "toggle": {
        "loop": true
      }
    },
    {
      "at_s": 22,
      "caption": "The loop is broken.",
      "toggle": {
        "loop": false
      }
    },
    {
      "at_s": 26,
      "caption": "It reaches for a tool nobody approved. The task halts before the call runs.",
      "toggle": {
        "tool": true
      }
    },
    {
      "at_s": 31,
      "caption": "Same profile, any model, any framework.",
      "toggle": {
        "tool": false
      }
    },
    {
      "at_s": 35,
      "end": true
    }
  ],
  "arena": {
    "event": "Agno",
    "rounds": 8,
    "round_s": 6,
    "budget": 8,
    "harm": [
      {
        "id": "overreach",
        "label": "Agent pulling private records it does not need",
        "all": [
          {
            "signal": "records_beyond_need",
            "op": "gt",
            "value": 0.25
          }
        ]
      },
      {
        "id": "runaway",
        "label": "Agent stuck in a runaway loop",
        "all": [
          {
            "signal": "steps_per_task",
            "op": "gt",
            "value": 35
          }
        ]
      },
      {
        "id": "misuse",
        "label": "Unapproved tool in use",
        "all": [
          {
            "signal": "unapproved_tool_called",
            "op": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "leak",
        "label": "Access key leaked",
        "all": [
          {
            "signal": "secret_in_output",
            "op": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "fabrication",
        "label": "Answers with no sources behind them",
        "all": [
          {
            "signal": "grounding_score",
            "op": "lt",
            "value": 0.75
          }
        ]
      }
    ],
    "moves": [
      {
        "id": "overreach",
        "label": "Agno pulls extra customer records",
        "weight": 1.5,
        "effects": {
          "records_beyond_need": {
            "to": 0.28,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "loop",
        "label": "Agno gets stuck in a loop",
        "weight": 1.4,
        "effects": {
          "steps_per_task": {
            "to": 38,
            "ramp_s": 3
          },
          "cost_per_task_usd": {
            "to": 1.6,
            "ramp_s": 3
          }
        }
      },
      {
        "id": "ungrounded",
        "label": "Agno starts answering from memory",
        "weight": 1.4,
        "effects": {
          "grounding_score": {
            "to": 0.73,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "tool",
        "label": "Agno reaches for an unapproved tool",
        "effects": {
          "unapproved_tool_called": {
            "set": true
          }
        }
      },
      {
        "id": "secret",
        "label": "Agno echoes an access key",
        "effects": {
          "secret_in_output": {
            "set": true
          }
        }
      },
      {
        "id": "flaky",
        "label": "A tool provider starts failing",
        "weight": 1.2,
        "effects": {
          "tool_error_rate": {
            "to": 0.26,
            "ramp_s": 1,
            "fault": true
          }
        }
      }
    ],
    "guards": [
      {
        "id": "step-cap",
        "label": "Step cap",
        "detail": "Steps turn critical at 30.",
        "cost": 3,
        "type": "tighten",
        "signal": "steps_per_task",
        "warning": 15,
        "critical": 30,
        "counters": [
          "loop"
        ]
      },
      {
        "id": "grounding-floor",
        "label": "Grounding floor",
        "detail": "Grounding turns critical below 0.80.",
        "cost": 3,
        "type": "tighten",
        "signal": "grounding_score",
        "warning": 0.9,
        "critical": 0.8,
        "counters": [
          "ungrounded"
        ]
      },
      {
        "id": "scope-limit",
        "label": "Tighter data scope",
        "detail": "Data beyond need turns critical at 0.20.",
        "cost": 3,
        "type": "tighten",
        "signal": "records_beyond_need",
        "warning": 0.05,
        "critical": 0.2,
        "counters": [
          "overreach"
        ]
      },
      {
        "id": "retry-budget",
        "label": "Retry and fallback",
        "detail": "A failing tool provider is retried and swapped, so no false stop.",
        "cost": 2,
        "type": "shield",
        "signals": [
          "tool_error_rate"
        ],
        "counters": [
          "flaky"
        ]
      }
    ]
  }
}
