{
  "pack_version": "1",
  "id": "robot-cell",
  "title": "Robot Cell",
  "subtitle": "A collaborative robot arm picking parts beside a person.",
  "scene": "robot-cell",
  "profile": "../../../examples/manufacturing-safety/trp.json",
  "command": {
    "group": "Robot cells",
    "unit": "Cell",
    "count": 16,
    "fault_rate": 0.02,
    "benign": [
      {
        "label": "A person walks past at 1.3 m",
        "effects": {
          "human_distance_m": {
            "to": 1.3,
            "ramp_s": 2
          }
        }
      },
      {
        "label": "A warm afternoon, motor at 74 degrees",
        "effects": {
          "temperature_C": {
            "to": 74,
            "ramp_s": 4
          }
        }
      },
      {
        "label": "A heavy part, vibration 0.95",
        "effects": {
          "vibration_rms_g": {
            "to": 0.95,
            "ramp_s": 2
          }
        }
      }
    ],
    "benign_rate": 0.02
  },
  "tick_ms": 250,
  "cycle_s": 4,
  "signals": {
    "human_distance_m": {
      "base": 2.6,
      "jitter": 0.02,
      "min": 0,
      "max": 4,
      "decimals": 2,
      "label": "Human distance"
    },
    "robot_speed_mm_s": {
      "base": 600,
      "jitter": 8,
      "min": 0,
      "max": 1400,
      "decimals": 0,
      "label": "Arm speed"
    },
    "vibration_rms_g": {
      "base": 0.34,
      "jitter": 0.02,
      "min": 0,
      "max": 2,
      "decimals": 2,
      "label": "Vibration"
    },
    "temperature_C": {
      "base": 52,
      "jitter": 0.3,
      "min": 20,
      "max": 100,
      "decimals": 1,
      "label": "Motor temperature"
    },
    "model_confidence": {
      "base": 0.94,
      "jitter": 0.01,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Model confidence"
    },
    "data_quality": {
      "base": 0.98,
      "jitter": 0.005,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Data quality"
    },
    "estop_active": {
      "base": false,
      "label": "Emergency stop"
    },
    "safety_certification_status": {
      "base": "valid",
      "label": "Safety certification"
    }
  },
  "rule_labels": {
    "estop_active": "Emergency stop pressed",
    "human_in_exclusion_zone": "Person inside the exclusion zone",
    "safety_certification_expired": "Safety certification expired",
    "critical_data_quality": "Data quality critically low"
  },
  "controls": [
    {
      "id": "distance",
      "label": "Person distance",
      "type": "slider",
      "signal": "human_distance_m",
      "min": 0.3,
      "max": 3.2,
      "step": 0.05
    },
    {
      "id": "speed",
      "label": "Arm speed",
      "type": "slider",
      "signal": "robot_speed_mm_s",
      "min": 200,
      "max": 1200,
      "step": 10
    },
    {
      "id": "loose",
      "label": "Loose fixture",
      "type": "toggle",
      "effects": {
        "vibration_rms_g": {
          "to": 1.32,
          "ramp_s": 2.5
        }
      }
    },
    {
      "id": "heat",
      "label": "Motor overheats",
      "type": "toggle",
      "effects": {
        "temperature_C": {
          "to": 84,
          "ramp_s": 6
        }
      }
    },
    {
      "id": "dropout",
      "label": "Sensor dropout",
      "type": "toggle",
      "effects": {
        "data_quality": {
          "to": 0.44,
          "ramp_s": 0.5
        },
        "human_distance_m": {
          "omit": true
        }
      }
    },
    {
      "id": "estop",
      "label": "Emergency stop",
      "type": "toggle",
      "effects": {
        "estop_active": {
          "set": true
        }
      }
    },
    {
      "id": "cert",
      "label": "Certification expires",
      "type": "toggle",
      "effects": {
        "safety_certification_status": {
          "set": "expired"
        }
      }
    }
  ],
  "story": [
    {
      "at_s": 0,
      "caption": "The cell runs normally. Every reading sits inside the profile's operating range."
    },
    {
      "at_s": 4,
      "caption": "A person walks toward the cell.",
      "set": {
        "distance": 1.25
      }
    },
    {
      "at_s": 9,
      "caption": "They step inside the exclusion zone. The profile's hard rule halts the arm.",
      "set": {
        "distance": 0.6
      }
    },
    {
      "at_s": 14,
      "caption": "They step back out, and the cell recovers.",
      "set": {
        "distance": 2.6
      }
    },
    {
      "at_s": 19,
      "caption": "A proximity sensor drops out. Missing evidence is treated as unknown, never as safe.",
      "toggle": {
        "dropout": true
      }
    },
    {
      "at_s": 25,
      "caption": "The sensor comes back.",
      "toggle": {
        "dropout": false
      }
    },
    {
      "at_s": 29,
      "caption": "A fixture works loose and vibration climbs past the warning line.",
      "toggle": {
        "loose": true
      }
    },
    {
      "at_s": 37,
      "caption": "Fixed. One profile, read by any evaluator, gives the same answer every time.",
      "toggle": {
        "loose": false
      }
    },
    {
      "at_s": 42,
      "end": true
    }
  ],
  "arena": {
    "event": "Robot Cell",
    "rounds": 8,
    "round_s": 6,
    "budget": 7,
    "harm": [
      {
        "id": "arm_near_person",
        "label": "Person within reach of a moving arm",
        "all": [
          {
            "signal": "human_distance_m",
            "op": "lt",
            "value": 0.7
          },
          {
            "signal": "estop_active",
            "op": "eq",
            "value": false
          }
        ]
      },
      {
        "id": "fast_arm_near_person",
        "label": "Fast arm close to a person",
        "all": [
          {
            "signal": "human_distance_m",
            "op": "lt",
            "value": 1.0
          },
          {
            "signal": "robot_speed_mm_s",
            "op": "gt",
            "value": 900
          }
        ]
      },
      {
        "id": "fixture_failure",
        "label": "Fixture shaking loose",
        "all": [
          {
            "signal": "vibration_rms_g",
            "op": "gt",
            "value": 1.25
          }
        ],
        "near": [
          {
            "signal": "vibration_rms_g",
            "op": "gt",
            "value": 1.1
          }
        ]
      },
      {
        "id": "motor_overheat",
        "label": "Motor overheating",
        "all": [
          {
            "signal": "temperature_C",
            "op": "gt",
            "value": 82
          }
        ],
        "near": [
          {
            "signal": "temperature_C",
            "op": "gt",
            "value": 76
          }
        ]
      },
      {
        "id": "uncertified",
        "label": "Running without a valid safety certification",
        "all": [
          {
            "signal": "safety_certification_status",
            "op": "eq",
            "value": "expired"
          }
        ]
      }
    ],
    "moves": [
      {
        "id": "approach",
        "label": "A person walks into the cell",
        "effects": {
          "human_distance_m": {
            "to": 0.55,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "rush",
        "label": "Rush job, fast arm with a person nearby",
        "weight": 1.6,
        "effects": {
          "human_distance_m": {
            "to": 0.9,
            "ramp_s": 2
          },
          "robot_speed_mm_s": {
            "to": 960,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "loose",
        "label": "A fixture works loose",
        "effects": {
          "vibration_rms_g": {
            "to": 1.32,
            "ramp_s": 2.5
          }
        }
      },
      {
        "id": "blind",
        "label": "Sensor drops out as a person walks in",
        "effects": {
          "data_quality": {
            "to": 0.44,
            "ramp_s": 0.5,
            "fault": true
          },
          "human_distance_m": {
            "to": 0.6,
            "ramp_s": 2,
            "omit": true
          }
        }
      },
      {
        "id": "glitch",
        "label": "A proximity sensor glitches",
        "weight": 1.4,
        "effects": {
          "data_quality": {
            "to": 0.44,
            "ramp_s": 0.5,
            "fault": true
          },
          "human_distance_m": {
            "omit": true
          }
        }
      },
      {
        "id": "heat",
        "label": "The motor runs hot",
        "effects": {
          "temperature_C": {
            "to": 84,
            "ramp_s": 4
          }
        }
      },
      {
        "id": "cert",
        "label": "The safety certification lapses",
        "effects": {
          "safety_certification_status": {
            "set": "expired"
          }
        }
      }
    ],
    "guards": [
      {
        "id": "second-sensor",
        "label": "Second proximity sensor",
        "detail": "A glitch or dropout on one sensor no longer blinds the cell.",
        "cost": 3,
        "type": "shield",
        "signals": [
          "human_distance_m",
          "data_quality"
        ],
        "counters": [
          "glitch",
          "blind"
        ]
      },
      {
        "id": "speed-limit",
        "label": "Lower speed limit",
        "detail": "Arm speed turns critical at 900 mm/s instead of 1,000.",
        "cost": 3,
        "type": "tighten",
        "signal": "robot_speed_mm_s",
        "warning": 700,
        "critical": 900,
        "counters": [
          "rush"
        ]
      },
      {
        "id": "wider-zone",
        "label": "Wider exclusion zone",
        "detail": "The arm halts when a person is within 1.0 m instead of 0.75 m.",
        "cost": 4,
        "type": "rule_value",
        "rule": "human_in_exclusion_zone",
        "value": 1.0,
        "counters": [
          "rush",
          "approach"
        ]
      },
      {
        "id": "heat-watch",
        "label": "Earlier heat warning",
        "detail": "Motor temperature turns critical at 76 C.",
        "cost": 2,
        "type": "tighten",
        "signal": "temperature_C",
        "warning": 66,
        "critical": 76,
        "counters": [
          "heat"
        ]
      }
    ]
  }
}
