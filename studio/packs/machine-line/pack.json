{
  "pack_version": "1",
  "id": "machine-line",
  "title": "Machine Line",
  "subtitle": "An automated line of machines and conveyors running in sequence.",
  "scene": "machine-line",
  "profile": "../../../examples/machine-line/trp.json",
  "tick_ms": 250,
  "cycle_s": 6,
  "signals": {
    "spindle_vibration_mm_s": {
      "base": 2.4,
      "jitter": 0.08,
      "min": 0,
      "max": 12,
      "decimals": 1,
      "label": "Spindle vibration"
    },
    "bearing_temperature_C": {
      "base": 58,
      "jitter": 0.3,
      "min": 20,
      "max": 110,
      "decimals": 1,
      "label": "Bearing temperature"
    },
    "line_speed_units_min": {
      "base": 110,
      "jitter": 1.5,
      "min": 0,
      "max": 200,
      "decimals": 0,
      "label": "Line speed"
    },
    "jam_rate_per_hour": {
      "base": 0.6,
      "jitter": 0.05,
      "min": 0,
      "max": 12,
      "decimals": 1,
      "label": "Jam rate"
    },
    "first_pass_yield": {
      "base": 0.985,
      "jitter": 0.002,
      "min": 0,
      "max": 1,
      "decimals": 3,
      "label": "First pass yield"
    },
    "sensor_health": {
      "base": 0.99,
      "jitter": 0.003,
      "min": 0,
      "max": 1,
      "decimals": 2,
      "label": "Sensor health"
    },
    "guard_door_open": {
      "base": false,
      "label": "Guard door"
    },
    "stop_circuit_ok": {
      "base": true,
      "label": "Stop circuit"
    },
    "lockout_tagout_active": {
      "base": false,
      "label": "Lockout and tagout"
    },
    "control_model_status": {
      "base": "validated",
      "label": "Control model"
    }
  },
  "rule_labels": {
    "guard_door_open": "Guard door open",
    "stop_circuit_fault": "Stop circuit fault",
    "lockout_tagout_active": "Lockout and tagout active",
    "unvalidated_control_model": "Control model not validated"
  },
  "controls": [
    {
      "id": "speed",
      "label": "Line speed",
      "type": "slider",
      "signal": "line_speed_units_min",
      "min": 60,
      "max": 180,
      "step": 1
    },
    {
      "id": "bearing",
      "label": "Bearing wears",
      "type": "toggle",
      "effects": {
        "spindle_vibration_mm_s": {
          "to": 7.6,
          "ramp_s": 8
        },
        "bearing_temperature_C": {
          "to": 82,
          "ramp_s": 10
        }
      }
    },
    {
      "id": "jams",
      "label": "Jams pile up",
      "type": "toggle",
      "effects": {
        "jam_rate_per_hour": {
          "to": 4.2,
          "ramp_s": 3
        },
        "first_pass_yield": {
          "to": 0.93,
          "ramp_s": 4
        }
      }
    },
    {
      "id": "door",
      "label": "Guard door opens",
      "type": "toggle",
      "effects": {
        "guard_door_open": {
          "set": true
        }
      }
    },
    {
      "id": "circuit",
      "label": "Stop circuit fault",
      "type": "toggle",
      "effects": {
        "stop_circuit_ok": {
          "set": false
        }
      }
    },
    {
      "id": "model",
      "label": "Unvalidated model",
      "type": "toggle",
      "effects": {
        "control_model_status": {
          "set": "unvalidated"
        }
      }
    }
  ],
  "story": [
    {
      "at_s": 0,
      "caption": "Parts move down the line at rated speed."
    },
    {
      "at_s": 4,
      "caption": "The line is pushed past its rated speed.",
      "set": {
        "speed": 142
      }
    },
    {
      "at_s": 10,
      "caption": "Back to rated speed.",
      "set": {
        "speed": 110
      }
    },
    {
      "at_s": 13,
      "caption": "A bearing starts to wear. Vibration and heat climb together.",
      "toggle": {
        "bearing": true
      }
    },
    {
      "at_s": 24,
      "caption": "Maintenance replaces it.",
      "toggle": {
        "bearing": false
      }
    },
    {
      "at_s": 28,
      "caption": "Someone opens a guard door while the line runs. It halts at once.",
      "toggle": {
        "door": true
      }
    },
    {
      "at_s": 33,
      "caption": "Door closed. The line restarts.",
      "toggle": {
        "door": false
      }
    },
    {
      "at_s": 37,
      "end": true
    }
  ],
  "arena": {
    "event": "Machine Line",
    "rounds": 8,
    "round_s": 6,
    "budget": 7,
    "harm": [
      {
        "id": "bearing_failure",
        "label": "Spindle bearing failing",
        "all": [
          {
            "signal": "spindle_vibration_mm_s",
            "op": "gt",
            "value": 7.4
          }
        ],
        "near": [
          {
            "signal": "spindle_vibration_mm_s",
            "op": "gt",
            "value": 5.8
          }
        ]
      },
      {
        "id": "door_open",
        "label": "Guard door open on a running line",
        "all": [
          {
            "signal": "guard_door_open",
            "op": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "runaway",
        "label": "Line running past its rated speed",
        "all": [
          {
            "signal": "line_speed_units_min",
            "op": "gt",
            "value": 150
          }
        ]
      },
      {
        "id": "jam_hazard",
        "label": "Jams forcing hands into the line",
        "all": [
          {
            "signal": "jam_rate_per_hour",
            "op": "gt",
            "value": 3.5
          }
        ]
      },
      {
        "id": "stop_fault",
        "label": "Emergency stop circuit dead",
        "all": [
          {
            "signal": "stop_circuit_ok",
            "op": "eq",
            "value": false
          }
        ]
      }
    ],
    "moves": [
      {
        "id": "bearing",
        "label": "A bearing wears out",
        "effects": {
          "spindle_vibration_mm_s": {
            "to": 7.6,
            "ramp_s": 5
          },
          "bearing_temperature_C": {
            "to": 82,
            "ramp_s": 6
          }
        }
      },
      {
        "id": "door",
        "label": "Someone opens a guard door",
        "effects": {
          "guard_door_open": {
            "set": true
          }
        }
      },
      {
        "id": "overspeed",
        "label": "The line is pushed past rated speed",
        "weight": 1.5,
        "effects": {
          "line_speed_units_min": {
            "to": 158,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "jams",
        "label": "Jams start piling up",
        "weight": 1.5,
        "effects": {
          "jam_rate_per_hour": {
            "to": 4.2,
            "ramp_s": 2
          }
        }
      },
      {
        "id": "circuit",
        "label": "The stop circuit fails",
        "effects": {
          "stop_circuit_ok": {
            "set": false
          }
        }
      },
      {
        "id": "model",
        "label": "An untested control model is pushed",
        "weight": 1.3,
        "effects": {
          "control_model_status": {
            "set": "unvalidated",
            "fault": true
          }
        }
      }
    ],
    "guards": [
      {
        "id": "speed-cap",
        "label": "Hard speed cap",
        "detail": "Line speed turns critical at 150 units per minute.",
        "cost": 3,
        "type": "tighten",
        "signal": "line_speed_units_min",
        "warning": 125,
        "critical": 150,
        "counters": [
          "overspeed"
        ]
      },
      {
        "id": "jam-rule",
        "label": "Jam stop rule",
        "detail": "Halt the line when jams pass 3 per hour.",
        "cost": 3,
        "type": "rule",
        "rule": {
          "rule": "jam_rate_high",
          "field": "jam_rate_per_hour",
          "condition": "greater_than",
          "value": 3,
          "action": "halt"
        },
        "counters": [
          "jams"
        ]
      },
      {
        "id": "release-gate",
        "label": "Model release gate",
        "detail": "Untested models never reach the line, so no surprise stops.",
        "cost": 2,
        "type": "shield",
        "signals": [
          "control_model_status"
        ],
        "counters": [
          "model"
        ]
      },
      {
        "id": "vibration-early",
        "label": "Earlier vibration alarm",
        "detail": "Spindle vibration turns critical at 6.0 mm/s.",
        "cost": 2,
        "type": "tighten",
        "signal": "spindle_vibration_mm_s",
        "warning": 3.5,
        "critical": 6.0,
        "counters": [
          "bearing"
        ]
      }
    ]
  }
}
